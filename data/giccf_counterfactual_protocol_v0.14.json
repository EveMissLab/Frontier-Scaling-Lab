    "synthetic",
    "observational"
  ],
  "data_principles": {
    "preserve_historical_assertions": true,
    "definitions_and_assessments_separate": true,
    "different_scenarios_not_pooled": true,
    "no_ai_is_not_no_science": true,
    "no_automatic_future_year": true,
