{
  "catalog_id": "FSL-PMQ",
  "version": "0.20.0",
  "created_on": "2026-11-08",
  "purpose_zh": "AI 實體製造的實物品質、實際合格產量、量測能力、成本、耐久性、超越當代人類工業品質前沿等非互相替代的可修訂研究軸。",
  "state": "definitions only, no real AI manufacturing performance implied",
  "comparison_baselines": [
    "H_PLUS_CURRENT_NON_AI_TOOLS",
    "CONVENTIONAL_NON_AI_AUTOMATION",
    "HUMAN_PLUS_AI_AUGMENTATION",
    "AI_MEDIATED_PHYSICAL_PRODUCTION"
  ],
  "human_comparison_note": "Current human civilization can use extant science, non-AI algorithms, robots, industrial tools, metrology and collaboration; never compare production AI against bare human only.",
  "evaluation_types": [
    "equal_budget_quality_comparison",
    "equal_quality_lifecycle_cost",
    "equal_time_accepted_throughput",
    "new_physical_property_candidate"
  ],
  "evidence_tiers": [
    "unobserved",
    "vendor_claim",
    "paper_reported",
    "reproducible_physical_test",
    "independent_physical_replication",
    "longitudinal_field_validation"
  ],
  "physical_completion_stages": [
    "design_only",
    "physical_prototype",
    "physical_function_test",
    "batch_repeatable",
    "field_durability_evidenced",
    "qualified_for_regulated_use",
    "sustainable_scaled_production"
  ],
  "candidate_claim_labels": [
    "unassessed",
    "quality_improvement_candidate",
    "beyond_contemporary_quality_frontier_candidate",
    "different_tradeoff_not_dominance",
    "uncertain",
    "measured_quality_regression"
  ],
  "quality_properties": [
    "accepted_throughput",
    "conformance",
    "precision",
    "variation",
    "defect_tail",
    "function",
    "durability",
    "material_novelty",
    "cost",
    "safety",
    "environment"
  ],
  "counterfactual": {
    "link": "FSL v0.14",
    "natural_human_baseline": "human_with_non_AI_scientific_and_industrial_technology",
    "future_no_ai_human_attainability": "unknown",
    "future_year": null
  },
  "guards": [
    "More quantity is not automatically better quality",
    "AI inspector accuracy is not actual product quality",
    "Simulated design is not qualified physical manufactured output",
    "Baseline includes best current human+nonAI industrial tools",
    "Uncertainty and traceable metrology required for precision comparison",
    "No zero-defect inference from small samples",
    "Pareto quality tradeoffs and legal safety gates cannot be collapsed into one score",
    "Novel properties require physical repeatability and independent verification",
    "Future human inability cannot be inferred from current missing demonstrations",
    "Cost denominators must use accepted and usable outputs plus lifecycle and warranty",
    "Do not double count rented hardware and owner depreciation or energy",
    "All AI core work vs human core work documented",
    "Physical multi-cycle quality does not itself certify Sigma_sys or Sigma_civ",
    "Preserve prior definitions and negative results in append-only records"
  ],
