  "conventions": {
    "no_ai_future_year": "null when unknown; optional structured conditional_range only with low/high/method/assumptions",
    "date": "timezone-aware ISO 8601 for temporal events",
    "examples": "Synthetic examples demonstrate data discipline only; no model evaluated.",
    "time_replay": "as-of requires both source published and FSL recorded no later than cutoff; corrections append new events",
    "comparability": "Task acceptance, budget, time, tool/algorithm boundary, human assistance and outcome criteria must be explicitly scoped."
